# Copy to .env for local development only. Never commit .env.
# Production secrets live in SOPS-encrypted files, not here.
POSTGRES_USER=propfirm
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=propfirm

# Twelve Data (compose.live.yaml): the API key. Never in chat, never committed.
# TWELVE_DATA_API_KEY=

# Twelve Data (compose.live.yaml): the API key. Never in chat, never committed.
# TWELVE_DATA_API_KEY=

# Payment method secrets (rule AC14): AES-256 key, 32 bytes base64. Make one with
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Without it the back office refuses to store any secret. Losing it makes the
# stored secrets unreadable: keep it with the other production secrets.
# PROPFIRM_SECRETS_KEY=
